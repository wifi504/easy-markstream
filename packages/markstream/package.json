{
  "name": "@ezview/markstream",
  "type": "module",
  "version": "0.1.3",
  "description": "Vue 3 开箱即用的流式 Markdown 渲染组件，基于 markstream-vue，内置 GitHub 浅色观感、Mermaid、ECharts、KaTeX、代码块高亮。",
  "author": "ezview",
  "license": "MIT",
  "homepage": "https://wifi504.github.io/easy-markstream/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wifi504/easy-markstream.git"
  },
  "bugs": {
    "url": "https://github.com/wifi504/easy-markstream/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "markdown",
    "streaming-markdown",
    "markstream",
    "katex",
    "mermaid",
    "echarts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm type-check && pnpm build",
    "publish:only": "pnpm publish --access public --no-git-checks --no-provenance --registry=https://registry.npmjs.org"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "katex": "^0.18.4",
    "markstream-vue": "^1.1.2",
    "mermaid": "^11.16.1",
    "stream-diffs": "^0.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.11",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vue": "^3.5.18",
    "vue-tsc": "^3.0.5"
  }
}
